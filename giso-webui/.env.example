# Copy this file to .env for local configuration.
GISO_IMAGE=ciscogisobuild/cisco-xr-gisobuild:2.3.4
LOG_LEVEL=INFO
GISO_PULL_TIMEOUT_SECONDS=600

# Optional Cisco Automated Software Distribution API credentials.
# Prefer *_FILE paths backed by Docker secrets instead of literal values.
CISCO_CLIENT_ID=
CISCO_CLIENT_SECRET=
CISCO_SECRETS_DIR=./secrets
CISCO_CLIENT_ID_FILE=/run/secrets/cisco_client_id
CISCO_CLIENT_SECRET_FILE=/run/secrets/cisco_client_secret
CISCO_DOWNLOAD_TIMEOUT_SECONDS=60
CISCO_DOWNLOAD_HOSTS=cisco.com

# Container storage paths
DATA_ROOT=/uploads
OUTPUT_ROOT=/output
TOOL_ROOT=/tool
WORK_ROOT=/work
ARCHIVE_ROOT=/archive
STATE_ROOT=/state

# Upload and extraction limits
MAX_UPLOAD_BYTES=8589934592
MAX_EXTRACTED_BYTES=17179869184
MAX_TAR_MEMBERS=10000
MAX_CHUNK_BYTES=16777216
MAX_LOG_BYTES=10485760
MAX_JOB_HISTORY=100
UPLOAD_SESSION_TTL=86400

# Archive policy: retain artifacts for 30 days, up to 50 GiB total
ARCHIVE_RETENTION_DAYS=30
MAX_ARCHIVE_BYTES=53687091200
ARCHIVE_CLEANUP_INTERVAL_SECONDS=3600

# Keep the service local unless you intentionally configure a reverse proxy
ALLOWED_HOSTS=127.0.0.1,localhost,giso-webui
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
